# Copy to .env and set your OpenRouter key to enable generated LLM answers.
# Without this, the app still returns retrieval-only excerpts with citations.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: cheaper verifier model for Check sources.
OPENROUTER_SOURCE_CHECK_MODEL=openai/gpt-5-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SubsiWiki AI
PORT=8787
VAULT_DIR=SubsiWiki

# Optional: enables live web search snippets through Browserbase.
BROWSERBASE_API_KEY=
WEB_CACHE_TTL_SECONDS=3600

# Optional if API is hosted elsewhere for the frontend:
# VITE_API_URL=http://localhost:8787
