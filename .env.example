# Copy to .env and set your OpenRouter key to enable generated LLM answers.
# Without this, the app still returns retrieval-only excerpts with citations.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SubsiWiki AI
PORT=8787
VAULT_DIR=SubsiWiki

# Optional: enables live web search and routes live page fetches through Browserbase.
# Without this key, explicit URL fetching falls back to a direct server-side fetch,
# while web search remains unavailable.
BROWSERBASE_API_KEY=
BROWSERBASE_FETCH_PROXIES=false

# Minimal agent guardrails.
AGENT_MAX_STEPS=8
AGENT_MAX_WEB_FETCHES=4
AGENT_MAX_WEB_SEARCHES=2

# Optional if API is hosted elsewhere for the frontend:
# VITE_API_URL=http://localhost:8787
